<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Greenlings.DevTools</AssemblyName>
    <RootNamespace>Greenlings.DevTools</RootNamespace>
    <IsPlugin>true</IsPlugin>
  </PropertyGroup>

  <!-- In-game scripts (gldev_run <name>) live in the repo's playtest/ folder. -->
  <ItemGroup>
    <Playtest Include="..\..\playtest\*.txt" />
    <None Include="@(Playtest)" Link="scripts\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <PluginExtraFile Include="@(Playtest->'scripts\%(Filename)%(Extension)')" />
  </ItemGroup>
</Project>
